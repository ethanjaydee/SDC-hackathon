# Local API server
PORT=8080
NODE_ENV=development

# Local frontend
BASE_PATH=/

# Optional RunPod AI integration
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/your-endpoint-id/runsync

# Optional Google Routes integration (server-side only)
# GOOGLE_MAPS_API_KEY=

# Optional Telegram integration
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_RECEIVER_ENABLED=false
# SESSION_SECRET=replace-with-a-long-random-local-secret
